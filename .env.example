# ============================================================
# ARGPULSE BOT — Variables de entorno
# Renombrá este archivo a .env y completá los valores reales
# NUNCA subas el archivo .env a git o compartas su contenido
# ============================================================

# --- X (Twitter) API Credentials ---
X_API_KEY=tu_api_key_aqui
X_API_SECRET=tu_api_secret_aqui
X_ACCESS_TOKEN=tu_access_token_aqui
X_ACCESS_TOKEN_SECRET=tu_access_token_secret_aqui
X_BEARER_TOKEN=tu_bearer_token_aqui

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# --- Configuración del sitio ---
WEBSITE_URL=https://argpulse.com
ANALYSIS_SECTION_TITLE=Análisis Diario

# --- Configuración del bot ---
# Máximo de tweets por hilo (entre 5 y 8)
MAX_TWEETS=8
MIN_TWEETS=5
TWEET_MAX_CHARS=280
